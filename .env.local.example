# GoHighLevel / LeadConnector — server (schedule API)
GHL_API_KEY=your_key_here
GHL_LOCATION_ID=your_location_id_here
GHL_CALENDAR_ID=your_calendar_id_here

# Chat widget (exposed to browser)
NEXT_PUBLIC_GHL_LOCATION_ID=your_location_id_here

# Stripe — copy to .env.local and fill from Stripe Dashboard
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Offer config — create Price in Stripe (see README / deploy docs)
STRIPE_OFFER_PRICE_ID=price_...
NEXT_PUBLIC_SITE_URL=https://101-jjkb-site.vercel.app
